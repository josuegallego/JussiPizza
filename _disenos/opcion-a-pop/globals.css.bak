@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --jussi-green: #4ebf4b;
  --jussi-beige: #f3edd6;
  --jussi-red: #f22233;
  --jussi-brown: #231107;
  --jussi-orange: #f27f1b;
}

html {
  scroll-behavior: smooth;
}

body {
  line-height: 1.6;
  color: var(--jussi-brown);
  background: var(--jussi-beige);
}

::selection {
  background: var(--jussi-orange);
  color: var(--jussi-brown);
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 10px;
}
::-webkit-scrollbar-track {
  background: var(--jussi-beige);
}
::-webkit-scrollbar-thumb {
  background: var(--jussi-brown);
  border-radius: 999px;
  border: 2px solid var(--jussi-beige);
}

/* Foco accesible */
button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 3px solid var(--jussi-orange);
  outline-offset: 3px;
}

/* Mapas responsive */
iframe {
  max-width: 100%;
}

/* ---------- Sistema de diseño Jussi ---------- */
@layer components {
  /* Titulares */
  .font-display {
    letter-spacing: -0.02em;
  }

  /* Botón principal: píldora con borde y sombra plana que "se hunde" al presionar */
  .btn-pop {
    @apply inline-flex items-center justify-center gap-2 rounded-full border-2 border-jussi-brown px-6 py-3 font-display text-base font-bold text-jussi-brown shadow-pop;
    @apply transition-[transform,box-shadow] duration-150 ease-out;
    @apply hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pop-lg;
    @apply active:translate-x-[3px] active:translate-y-[3px] active:shadow-none;
  }
  .btn-pop-green {
    @apply btn-pop bg-jussi-green;
  }
  .btn-pop-red {
    @apply btn-pop bg-jussi-red text-white;
  }
  .btn-pop-orange {
    @apply btn-pop bg-jussi-orange;
  }
  .btn-pop-beige {
    @apply btn-pop bg-jussi-beige;
  }
  .btn-pop-lg {
    @apply px-8 py-4 text-lg;
  }

  /* Tarjeta: borde grueso + sombra plana */
  .card-pop {
    @apply rounded-3xl border-2 border-jussi-brown bg-white shadow-pop;
  }

  /* Etiqueta tipo sticker */
  .sticker {
    @apply inline-flex items-center gap-2 rounded-full border-2 border-jussi-brown px-4 py-1.5 font-display text-sm font-bold shadow-pop-sm;
  }

  /* Encabezado de sección */
  .eyebrow {
    @apply mb-3 inline-block rounded-full border-2 border-jussi-brown bg-jussi-orange px-3 py-1 font-display text-xs font-bold uppercase tracking-widest text-jussi-brown;
  }
}

/* Animaciones */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.6s ease-out both;
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

.animate-marquee {
  animation: marquee 28s linear infinite;
}

@keyframes wobble {
  0%,
  100% {
    transform: rotate(-6deg);
  }
  50% {
    transform: rotate(4deg);
  }
}

.animate-wobble {
  animation: wobble 4s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  .animate-marquee,
  .animate-wobble,
  .animate-fade-in {
    animation: none;
  }
  html {
    scroll-behavior: auto;
  }
}

/* Pizza size circles responsive (flujo de pedido) */
@media (max-width: 640px) {
  .pizza-size-circle {
    width: 50px !important;
    height: 50px !important;
  }
}
