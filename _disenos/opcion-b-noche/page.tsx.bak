"use client"

import { useState, useEffect, type ReactNode } from "react"
import {
  MapPin,
  Instagram,
  MessageCircle,
  Award,
  Pizza,
  Clock,
  Users,
  ArrowUpRight,
  Menu,
  X,
  Flame,
} from "lucide-react"
import { useRouter } from "next/navigation"

const locations = [
  {
    name: "Sede Sachamate",
    address: "Cra 18 #12-22 Barrio Sachamate",
    hint: "Barrio al lado del parque Sachamate",
    phone: "573172697230",
    accent: "bg-jussi-green",
    mapSrc:
      "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3983.3354983682593!2d-76.54898070321042!3d3.266644999999991!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e309eb5f479442f%3A0xb90023a4b91e072d!2sJussi%20Pizza!5e0!3m2!1sen!2sco!4v1750386486959!5m2!1sen!2sco",
  },
  {
    name: "Sede Anturios",
    address: "Jussi Pizza Cra. 19 A #3-03",
    hint: "Sector de Alfaguara / Parque Natura",
    phone: "573168403329",
    accent: "bg-jussi-orange",
    mapSrc:
      "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3983.3354983682593!2d-76.54898070321042!3d3.266644999999991!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e309983d6c3c0e7%3A0x556bfa1aac6aae29!2sJussi%20Pizza!5e0!3m2!1sen!2sco!4v1750386509586!5m2!1sen!2sco",
  },
]

const gallery = [
  { src: "/JUSSI PIZZA JAMUNDI 2020 (2).jpg", alt: "Nuestras pizzas", title: "Nuestras pizzas", description: "Hechas con amor y los mejores ingredientes" },
  { src: "/JUSSI PIZZA JAMUNDI 2020 (4).jpg", alt: "Interior acogedor del restaurante", title: "Ambiente familiar", description: "Perfecto para compartir" },
  { src: "/JUSSI PIZZA JAMUNDI 2020 (12).jpg", alt: "Preparando masa de pizza", title: "Proceso artesanal", description: "Masa fresca todos los días" },
  { src: "/JUSSI PIZZA JAMUNDI 2020 (34).jpg", alt: "Ingredientes frescos", title: "Ingredientes frescos", description: "Solo lo mejor en cada pizza" },
  { src: "/IMG_0096.jpg", alt: "Familia disfrutando pizza", title: "Momentos especiales", description: "Recuerdos deliciosos desde 2015" },
]

const navItems = [
  { id: "home", label: "Inicio" },
  { id: "locations", label: "Ubicaciones" },
  { id: "contact", label: "Contacto" },
]

const marqueeItems = [
  "Pizza crocante",
  "En las manos de Dios",
  "Ingredientes frescos",
  "Ganadores Pizza Fest 2021",
  "Receta tradicional",
  "Hecha con mucho amor",
]

/** Aparición al hacer scroll (CSS puro, ver .reveal en globals.css) */
function Reveal({ children, className = "" }: { children: ReactNode; delay?: number; className?: string }) {
  return <div className={`reveal ${className}`}>{children}</div>
}

export default function Home() {
  const router = useRouter()
  const [activeSection, setActiveSection] = useState("home")
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false)
  const [sedeModalOpen, setSedeModalOpen] = useState(false)

  const handleOrderClick = () => router.push("/pedido")

  const openWhatsApp = (location: (typeof locations)[number]) => {
    const message = encodeURIComponent(`¡Hola! Me gustaría hacer un pedido de pizza 🍕 para la ${location.name}`)
    window.open(
      `https://api.whatsapp.com/send/?phone=${location.phone}&text=${message}&type=phone_number&app_absent=0`,
      "_blank",
    )
    setSedeModalOpen(false)
  }

  const handleInstagramClick = () => window.open("https://instagram.com/jussipizza_", "_blank")

  const scrollToSection = (sectionId: string) => {
    document.getElementById(sectionId)?.scrollIntoView({ behavior: "smooth" })
    setActiveSection(sectionId)
    setMobileMenuOpen(false)
  }

  useEffect(() => {
    const handleScroll = () => {
      const scrollPosition = window.scrollY + 140
      for (const item of navItems) {
        const element = document.getElementById(item.id)
        if (element && scrollPosition >= element.offsetTop && scrollPosition < element.offsetTop + element.offsetHeight) {
          setActiveSection(item.id)
          break
        }
      }
    }
    handleScroll()
    window.addEventListener("scroll", handleScroll, { passive: true })
    return () => window.removeEventListener("scroll", handleScroll)
  }, [])

  useEffect(() => {
    if (!sedeModalOpen) return
    const onKey = (e: KeyboardEvent) => e.key === "Escape" && setSedeModalOpen(false)
    window.addEventListener("keydown", onKey)
    return () => window.removeEventListener("keydown", onKey)
  }, [sedeModalOpen])

  return (
    <div className="min-h-screen bg-jussi-beige text-jussi-brown">
      {/* Header flotante */}
      <header className="fixed left-0 right-0 top-3 z-50 px-3 md:top-5 md:px-6">
        <div className="mx-auto max-w-5xl rounded-full border-2 border-jussi-brown bg-jussi-beige shadow-pop">
          <div className="flex items-center justify-between py-2 pl-2 pr-2 md:pl-3 md:pr-3">
            <button onClick={() => scrollToSection("home")} className="flex items-center gap-3" aria-label="Ir al inicio">
              <span className="flex h-11 w-11 items-center justify-center overflow-hidden rounded-full border-2 border-jussi-brown bg-jussi-red">
                <img src="/logo beige.png" alt="Jussi Pizza" className="h-8 w-8 object-contain" />
              </span>
              <span className="text-left leading-tight">
                <span className="block font-display text-base font-bold">Jussi Pizza</span>
                <span className="hidden text-xs font-medium opacity-70 sm:block">Jamundí, Valle del Cauca</span>
              </span>
            </button>

            <nav className="hidden items-center gap-1 md:flex">
              {navItems.map((item) => (
                <button
                  key={item.id}
                  onClick={() => scrollToSection(item.id)}
                  className={`rounded-full px-4 py-2 font-display text-sm font-semibold transition-colors ${
                    activeSection === item.id ? "bg-jussi-brown text-jussi-beige" : "hover:bg-jussi-brown/10"
                  }`}
                >
                  {item.label}
                </button>
              ))}
              <button onClick={handleOrderClick} className="btn-pop btn-pop-red btn-pop-sm ml-2">
                Pedir ahora
              </button>
            </nav>

            <button
              className="flex h-11 w-11 items-center justify-center rounded-full border-2 border-jussi-brown bg-jussi-orange md:hidden"
              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
              aria-label={mobileMenuOpen ? "Cerrar menú" : "Abrir menú"}
              aria-expanded={mobileMenuOpen}
            >
              {mobileMenuOpen ? <X className="h-5 w-5" /> : <Menu className="h-5 w-5" />}
            </button>
          </div>

          {mobileMenuOpen && (
            <nav className="flex flex-col gap-2 border-t-2 border-jussi-brown p-4 md:hidden">
              {navItems.map((item) => (
                <button
                  key={item.id}
                  onClick={() => scrollToSection(item.id)}
                  className={`rounded-full px-4 py-3 text-left font-display font-semibold ${
                    activeSection === item.id ? "bg-jussi-brown text-jussi-beige" : "bg-white/60"
                  }`}
                >
                  {item.label}
                </button>
              ))}
              <button onClick={handleOrderClick} className="btn-pop btn-pop-red mt-1 w-full">
                Pedir ahora
              </button>
            </nav>
          )}
        </div>
      </header>

      {/* Hero */}
      <section
        id="home"
        className="relative flex min-h-screen items-end overflow-hidden px-4 pb-14 pt-36 md:px-8 md:pb-20"
        style={{ clipPath: "inset(0)" }}
      >
        {/* Parallax: imagen fija, recortada al área del hero */}
        <div className="fixed inset-0 z-0">
          <img src="/IMG_0096.jpg" alt="" className="h-full w-full object-cover object-center" />
        </div>
        <div className="absolute inset-0 z-10 bg-jussi-brown/50" />
        <div className="absolute inset-0 z-10 bg-gradient-to-t from-jussi-brown via-jussi-brown/30 to-transparent" />

        <div className="edge-light relative z-20 mx-auto w-full max-w-7xl">
          <div className="animate-rise mb-6 flex flex-wrap items-center gap-2 text-jussi-beige" style={{ "--delay": "100ms" } as React.CSSProperties}>
            <span className="tag border-jussi-beige/40">
              <MapPin className="h-3.5 w-3.5" /> Jamundí · Valle del Cauca
            </span>
            <span className="tag border-jussi-brown bg-jussi-orange text-jussi-brown">
              <Flame className="h-3.5 w-3.5" /> Pizza crocante
            </span>
          </div>

          <h1
            className="animate-rise font-display text-[17vw] font-extrabold uppercase leading-[0.88] text-jussi-beige sm:text-[15vw] md:text-[10.5vw]"
            style={{ "--delay": "200ms" } as React.CSSProperties}
          >
            Jussi
            <br />
            <span aria-label="Pizza">
              <span className="text-jussi-green" aria-hidden>Pi</span>
              <span aria-hidden>zz</span>
              <span className="text-jussi-red" aria-hidden>a</span>
            </span>
          </h1>

          <div className="mt-8 flex flex-col gap-8 md:mt-10 md:flex-row md:items-end md:justify-between">
            <div className="animate-rise max-w-xl" style={{ "--delay": "400ms" } as React.CSSProperties}>
              <p className="font-display text-xl font-semibold text-jussi-orange md:text-2xl">En las manos de Dios</p>
              <p className="mt-3 text-base leading-relaxed text-jussi-beige/85 md:text-lg">
                Auténtica pizza en el corazón de Jamundí. Ingredientes frescos, tradición italiana y el sabor único
                colombiano, con dedicación, pasión… y mucho amor.
              </p>
              <div className="mt-8 flex flex-wrap gap-4">
                <button onClick={handleOrderClick} className="btn-pop btn-pop-green btn-pop-lg">
                  ¡Pedir ahora!
                  <ArrowUpRight className="h-5 w-5" />
                </button>
                <button onClick={() => scrollToSection("locations")} className="btn-pop btn-pop-beige btn-pop-lg">
                  <MapPin className="h-5 w-5" />
                  Ver ubicaciones
                </button>
              </div>
            </div>

            {/* Sello giratorio */}
            <div className="animate-rise relative hidden h-40 w-40 flex-shrink-0 md:block" style={{ "--delay": "600ms" } as React.CSSProperties}>
              <svg viewBox="0 0 200 200" className="animate-spin-slow h-full w-full" aria-hidden>
                <defs>
                  <path id="seal" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0" />
                </defs>
                <text className="fill-jussi-beige font-display text-[15px] font-semibold uppercase tracking-[0.18em]">
                  <textPath href="#seal">Ganadores · Pizza Fest 2021 · Ganadores ·</textPath>
                </text>
              </svg>
              <span className="absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full border-2 border-jussi-beige bg-jussi-red text-white">
                <Award className="h-7 w-7" />
              </span>
            </div>
          </div>
        </div>
      </section>

      {/* Cinta */}
      <div className="relative z-10 overflow-hidden bg-jussi-orange py-4">
        <div className="animate-marquee flex w-max whitespace-nowrap">
          {[...marqueeItems, ...marqueeItems, ...marqueeItems, ...marqueeItems].map((item, i) => (
            <span key={i} className="mx-5 flex items-center gap-10 font-display text-lg font-bold uppercase md:text-xl">
              {item}
              <Pizza className="h-5 w-5" aria-hidden />
            </span>
          ))}
        </div>
      </div>

      {/* Presentación */}
      <section className="relative z-10 bg-jussi-beige px-4 py-20 md:px-8 md:py-32">
        <div className="mx-auto max-w-5xl">
          <Reveal>
            <p className="font-display text-3xl font-semibold leading-[1.25] md:text-5xl">
              Pizza crocante hecha con{" "}
              <span className="rounded-full bg-jussi-green px-4 py-0.5">ingredientes frescos</span>, receta{" "}
              <span className="rounded-full bg-jussi-orange px-4 py-0.5">tradicional</span> y{" "}
              <span className="rounded-full bg-jussi-red px-4 py-0.5 text-white">mucho amor</span>. Para comer en casa,
              para llevar o para compartir en la mesa.
            </p>
          </Reveal>

          <div className="mt-14 grid grid-cols-3 gap-4 border-t border-jussi-brown/20 pt-8">
            {[
              { n: "2", l: "sedes en Jamundí" },
              { n: "2021", l: "Ganadores Pizza Fest" },
              { n: "2015", l: "sirviendo sabor" },
            ].map((s, i) => (
              <Reveal key={s.l} delay={i * 120}>
                <div className="font-display text-4xl font-extrabold md:text-6xl">{s.n}</div>
                <div className="mt-1 text-sm font-semibold opacity-70 md:text-base">{s.l}</div>
              </Reveal>
            ))}
          </div>
        </div>
      </section>

      {/* Galería bento */}
      <section className="bg-jussi-brown px-4 py-20 text-jussi-beige md:px-8 md:py-28">
        <div className="mx-auto max-w-7xl">
          <Reveal className="mb-10 md:mb-14">
            <span className="tag border-jussi-beige/30 text-jussi-orange">Conócenos</span>
            <h2 className="mt-4 max-w-3xl font-display text-4xl font-extrabold md:text-6xl">¡Ven y descúbrenos!</h2>
          </Reveal>

          <div className="grid auto-rows-[150px] grid-flow-dense grid-cols-2 gap-3 md:auto-rows-[220px] md:grid-cols-4 md:gap-4">
            {[
              { i: 0, cls: "col-span-2 row-span-2" },
              { i: 1, cls: "" },
              { t: "red" as const, cls: "" },
              { i: 2, cls: "col-span-2" },
              { i: 3, cls: "" },
              { i: 4, cls: "col-span-2" },
              { t: "orange" as const, cls: "" },
            ].map((tile, idx) => {
              const image = tile.i !== undefined ? gallery[tile.i] : null
              return (
                <Reveal key={idx} delay={idx * 70} className={`${tile.cls} h-full`}>
                  {image ? (
                    <figure className="group relative h-full overflow-hidden rounded-[1.75rem]">
                      <img
                        src={image.src}
                        alt={image.alt}
                        className="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                      />
                      <div className="absolute inset-0 bg-gradient-to-t from-jussi-brown/85 via-jussi-brown/10 to-transparent" />
                      <figcaption className="absolute inset-x-0 bottom-0 p-4 md:p-6">
                        <div className="font-display text-base font-semibold md:text-xl">{image.title}</div>
                        <div className="mt-0.5 hidden text-sm opacity-80 md:block">{image.description}</div>
                      </figcaption>
                    </figure>
                  ) : tile.t === "red" ? (
                    <div className="flex h-full flex-col justify-between rounded-[1.75rem] bg-jussi-red p-5 text-white">
                      <Flame className="h-8 w-8" />
                      <div className="font-display text-lg font-bold leading-tight md:text-2xl">Pizza crocante</div>
                    </div>
                  ) : (
                    <div className="flex h-full flex-col justify-between rounded-[1.75rem] bg-jussi-orange p-5 text-jussi-brown">
                      <Award className="h-8 w-8" />
                      <div className="font-display text-lg font-bold leading-tight md:text-2xl">Ganadores Pizza Fest 2021</div>
                    </div>
                  )}
                </Reveal>
              )
            })}
          </div>
        </div>
      </section>

      {/* Ubicaciones */}
      <section id="locations" className="relative overflow-hidden bg-jussi-beige px-4 py-20 md:px-8 md:py-28">
        <div className="mx-auto max-w-7xl">
          <Reveal className="mb-12 md:mb-16">
            <div className="flex flex-wrap items-end justify-between gap-6">
              <div>
                <span className="tag border-jussi-brown/30">Dónde estamos</span>
                <h2 className="mt-4 font-display text-5xl font-extrabold md:text-7xl">
                  Nuestras <span className="text-jussi-red">sedes</span>
                </h2>
                <p className="mt-4 max-w-xl text-lg opacity-75">
                  Dos sedes en Jamundí para servirte mejor. ¡Visítanos o pide a domicilio!
                </p>
              </div>
              <span className="sticker hidden -rotate-6 bg-jussi-green md:inline-flex">
                <MapPin className="h-4 w-4" /> Siempre cerca de ti
              </span>
            </div>
          </Reveal>

          <div className="space-y-8 md:space-y-10">
            {locations.map((location, i) => (
              <Reveal key={location.name}>
                <article className={`card-pop grid overflow-hidden lg:grid-cols-12 ${location.accent}`}>
                  <div className={`flex flex-col p-6 md:p-10 lg:col-span-5 ${i % 2 ? "lg:order-2" : ""}`}>
                    <span className="font-display text-7xl font-extrabold leading-none text-jussi-brown/25 md:text-8xl">
                      0{i + 1}
                    </span>
                    <h3 className="mt-2 font-display text-3xl font-extrabold md:text-4xl">{location.name}</h3>
                    <p className="mt-3 flex items-start gap-2 font-semibold">
                      <MapPin className="mt-1 h-5 w-5 flex-shrink-0" />
                      {location.address}
                    </p>
                    <p className="mt-1 pl-7 text-sm font-medium opacity-75">{location.hint}</p>

                    <div className="mt-5 flex flex-wrap gap-2">
                      {["Domicilio", "Para llevar", "En sitio"].map((t) => (
                        <span key={t} className="rounded-full border-2 border-jussi-brown bg-jussi-beige px-3 py-1 text-xs font-bold">
                          {t}
                        </span>
                      ))}
                    </div>

                    <div className="mt-auto flex flex-wrap gap-4 pt-8">
                      <button onClick={() => setSedeModalOpen(true)} className="btn-pop btn-pop-dark">
                        <MessageCircle className="h-4 w-4" />
                        Escribir
                      </button>
                      <button
                        onClick={() => window.open(`https://maps.google.com/?q=${encodeURIComponent(location.address)}`, "_blank")}
                        className="btn-pop btn-pop-beige"
                      >
                        Cómo llegar
                        <ArrowUpRight className="h-4 w-4" />
                      </button>
                    </div>
                  </div>

                  <div className="p-3 pt-0 md:p-4 lg:col-span-7">
                    <div className="h-full min-h-[300px] overflow-hidden rounded-[1.5rem] border-2 border-jussi-brown bg-white lg:min-h-[420px]">
                      <iframe
                        src={location.mapSrc}
                        title={`Mapa ${location.name}`}
                        width="100%"
                        style={{ border: 0, display: "block", height: "100%", minHeight: "inherit" }}
                        allowFullScreen
                        loading="lazy"
                        referrerPolicy="no-referrer-when-downgrade"
                      />
                    </div>
                  </div>
                </article>
              </Reveal>
            ))}
          </div>
        </div>
      </section>

      {/* Contacto */}
      <section id="contact" className="bg-jussi-brown px-4 pb-10 pt-20 text-jussi-beige md:px-8 md:pt-28">
        <div className="mx-auto max-w-7xl">
          <Reveal>
            <h2 className="font-display text-[13vw] font-extrabold uppercase leading-[0.9] md:text-[8vw]">
              ¿Antojo
              <br />
              de <span className="text-jussi-orange">pizza?</span>
            </h2>
            <p className="mt-6 max-w-xl text-lg opacity-80">
              Haz tu pedido en segundos desde nuestro enlace o escríbenos directo. ¡Estamos para servirte!
            </p>
            <div className="edge-light mt-8 flex flex-wrap gap-4">
              <button onClick={handleOrderClick} className="btn-pop btn-pop-red btn-pop-lg">
                Pedir en línea
                <ArrowUpRight className="h-5 w-5" />
              </button>
              <button onClick={() => setSedeModalOpen(true)} className="btn-pop btn-pop-green btn-pop-lg">
                <MessageCircle className="h-5 w-5" />
                WhatsApp
              </button>
              <button onClick={handleInstagramClick} className="btn-pop btn-pop-orange btn-pop-lg">
                <Instagram className="h-5 w-5" />
                Instagram
              </button>
            </div>
          </Reveal>

          <div className="mt-20 grid grid-cols-1 border-t border-jussi-beige/15 md:grid-cols-3">
            {[
              { Icon: Clock, title: "Horarios", lines: ["Miércoles a Lunes", "6:00 PM - 10:30 PM"] },
              { Icon: Users, title: "Servicio", lines: ["Domicilio", "Para llevar", "Consumo en sitio"] },
              { Icon: Pizza, title: "Especialidad", lines: ["Pizza crocante", "Ingredientes frescos", "Receta tradicional"] },
            ].map(({ Icon, title, lines }, i) => (
              <div key={title} className={`py-8 md:px-8 md:first:pl-0 ${i > 0 ? "border-t border-jussi-beige/15 md:border-l md:border-t-0" : ""}`}>
                <Icon className="mb-4 h-7 w-7 text-jussi-orange" />
                <h3 className="mb-2 font-display text-xl font-bold">{title}</h3>
                <p className="opacity-75">
                  {lines.map((line) => (
                    <span key={line} className="block">
                      {line}
                    </span>
                  ))}
                </p>
              </div>
            ))}
          </div>

          <div className="flex flex-col gap-1 border-t border-jussi-beige/15 pt-6 text-sm opacity-60 md:flex-row md:justify-between">
            <p>© {new Date().getFullYear()} Jussi Pizza · Jamundí, Valle del Cauca, Colombia</p>
            <p>Ganadores Pizza Fest 2021 🏆</p>
          </div>
        </div>
      </section>

      {/* Modal de sede para WhatsApp */}
      {sedeModalOpen && (
        <div
          className="fixed inset-0 z-[100] flex items-end justify-center bg-jussi-brown/80 p-4 backdrop-blur-sm sm:items-center"
          onClick={() => setSedeModalOpen(false)}
          role="dialog"
          aria-modal="true"
          aria-label="Elegir sede"
        >
          <div className="animate-fade-in w-full max-w-md rounded-[2rem] bg-jussi-beige p-6 md:p-8" onClick={(e) => e.stopPropagation()}>
            <div className="mb-6">
              <h3 className="font-display text-2xl font-extrabold">¿En cuál sede deseas ordenar?</h3>
              <p className="mt-1 opacity-70">Elige la ubicación más cercana a ti</p>
            </div>

            <div className="mb-3 space-y-3">
              {locations.map((location) => (
                <button
                  key={location.name}
                  onClick={() => openWhatsApp(location)}
                  className={`${location.accent} flex w-full items-center justify-between rounded-2xl p-4 text-left transition-transform hover:scale-[1.02] active:scale-95`}
                >
                  <span>
                    <span className="block font-display text-lg font-bold">{location.name}</span>
                    <span className="block text-sm font-medium opacity-75">{location.hint}</span>
                  </span>
                  <ArrowUpRight className="h-6 w-6 flex-shrink-0" />
                </button>
              ))}
            </div>

            <button onClick={() => setSedeModalOpen(false)} className="w-full py-2 font-semibold opacity-60 hover:opacity-100">
              Cancelar
            </button>
          </div>
        </div>
      )}
    </div>
  )
}
